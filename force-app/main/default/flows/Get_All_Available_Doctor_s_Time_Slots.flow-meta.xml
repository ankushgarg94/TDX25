    <formulas>
        <name>AppointmetDateDay</name>
        <dataType>String</dataType>
        <expression>CASE(
  MOD({!DateOfAppointment} - DATE(1900, 1, 7), 7),
  0, &quot;Sunday&quot;,
  1, &quot;Monday&quot;,
  2, &quot;Tuesday&quot;,
  3, &quot;Wednesday&quot;,
  4, &quot;Thursday&quot;,
  5, &quot;Friday&quot;,
  6, &quot;Saturday&quot;,
  &quot;Monday&quot;
)</expression>
    </formulas>
